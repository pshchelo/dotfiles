# second theme option overrides the first.
# comment out the second theme to have the light/dark follow system settings
theme = dark:iTerm2 Solarized Dark,light:iTerm2 Solarized Light
theme = solarized-dark
#theme = iTerm2 Solarized Dark
font-family = "AnonymicePro Nerd Font"
font-size = 18

copy-on-select = clipboard
link-url = true
mouse-hide-while-typing = true
window-padding-balance = true

shell-integration = bash
shell-integration-features = true

macos-non-native-fullscreen = true
macos-option-as-alt = true
